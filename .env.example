# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). .env.local is already gitignored.

# Safe to expose to the browser — protected by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER prefix this with NEXT_PUBLIC_. Server-only: Server Actions / Route
# Handlers / scheduled jobs. Bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Feature flag for the Kakao login button. Kakao's authorize request always
# includes the account_email scope; leave "false" until Kakao approves our
# app's consent request for that item, then flip to "true" — no code change.
NEXT_PUBLIC_KAKAO_LOGIN_ENABLED=false

# SerpApi key (serpapi.com) — used by scripts/verify-serpapi-hotels.ts to
# check the Google Hotels engine response shape before any app code depends
# on it. Not read by the Next.js app itself yet.
SERPAPI_API_KEY=

# Shared secret the price-check cron must present. Required on both GET and
# POST /api/notifications/check as `Authorization: Bearer <value>` — this is
# the header Vercel Cron sends automatically when CRON_SECRET is set on the
# project, so set the same value here and in the Vercel project's env vars.
CRON_SECRET=
