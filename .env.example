# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). .env.local is already gitignored.

# Safe to expose to the browser — protected by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER prefix this with NEXT_PUBLIC_. Server-only: Server Actions / Route
# Handlers / scheduled jobs. Bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# SerpApi key (serpapi.com) — the real price source once this and Supabase
# are both set (src/lib/hotels/index.ts); without it the app falls back to
# the mock Agoda provider entirely. Also used by the standalone scripts
# (verify-serpapi-hotels.ts, verify-agoda-coverage.ts, seed-hotel-catalog.ts).
SERPAPI_API_KEY=

# Real SerpApi calls allowed per day, shared by the price-check cron and
# tracking-start (src/lib/serpapi/callBudget.ts). Defaults to 7 if unset —
# free SerpApi plan is 250/month, divided by ~30 days with headroom.
SERPAPI_DAILY_LIMIT=

# How much of SERPAPI_DAILY_LIMIT the cron must always leave unspent so
# tracking-start never gets starved by the cron using up the whole day's
# budget. Defaults to 2 if unset.
SERPAPI_CRON_RESERVE=

# Shared secret the price-check cron must present. Required on both GET and
# POST /api/notifications/check as `Authorization: Bearer <value>` — this is
# the header Vercel Cron sends automatically when CRON_SECRET is set on the
# project, so set the same value here and in the Vercel project's env vars.
CRON_SECRET=

# Firebase service-account credentials for sending FCM push (Firebase
# console -> Project settings -> Service accounts -> Generate new private
# key). Server-only, never prefix with NEXT_PUBLIC_. All three must be set
# together or src/lib/notifications/index.ts falls back to in-app-only
# notifications (src/lib/notifications/push/env.ts#isFcmConfigured).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the private_key value from the service-account JSON as-is, including
# the escaped "\n" sequences — src/lib/notifications/push/env.ts converts
# them back to real newlines.
FCM_PRIVATE_KEY=

# Play Store listing URL for the Android app. Leave unset until the app is
# actually published — src/components/notifications/AppDownloadBanner.tsx
# renders nothing at all without it, rather than link to a store page that
# doesn't exist yet.
NEXT_PUBLIC_PLAY_STORE_URL=
